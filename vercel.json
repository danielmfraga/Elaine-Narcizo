{
  "redirects": [
    { "source": "/", "destination": "/repertorios-sensiveis/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|svg|jpg|jpeg|png|webp|mp4|webm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ]
}
